{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": {
          "tool_name": "Write",
          "file_path": "**/sections/*.md"
        },
        "command": "echo '[Hook] Section file created: $TOOL_INPUT_FILE_PATH'"
      },
      {
        "matcher": {
          "tool_name": "Write",
          "file_path": "**/project-tb.md"
        },
        "command": "echo '[Hook] Term Base updated: $TOOL_INPUT_FILE_PATH'"
      },
      {
        "matcher": {
          "tool_name": "Write",
          "file_path": "**/translation-final.md"
        },
        "command": "echo '[Hook] Final translation created - ready for Word conversion'"
      }
    ],
    "Stop": [
      {
        "command": "echo '[Hook] Translation session ended. Remember to review output files in output/[project-name]/'"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(pip:*)",
      "Read(**/*)",
      "Write(**/output/**/*)",
      "Write(**/.claude/skills/patent-translator/data/**/*)",
      "Edit(**/*)"
    ],
    "deny": []
  }
}
